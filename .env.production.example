# .env.production.example
#
# Copy this file to `.env` ON THE AWS SERVER (never commit the real one):
#   cp .env.production.example .env
# then replace every CHANGE_ME value. docker-compose.prod.yml reads this file and
# mounts it into the app containers.
#
# Inside Docker, the hosts are the service names: DB_HOST=mysql, REDIS_HOST=redis.

APP_NAME="Mini CRM"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # generate once: php artisan key:generate --show  (run locally) and paste here
APP_URL=https://crm.example.com
APP_DOMAIN=crm.example.com    # the domain Caddy issues an HTTPS certificate for
TRUSTED_PROXIES=*             # Caddy is the only thing that can reach the app; trust its headers

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Database (MySQL container) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mini_crm
DB_USERNAME=mini_crm
DB_PASSWORD=CHANGE_ME_strong_app_db_password
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# ── Sessions, cache, queue ──────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PORT=6379

# ── Email (Amazon SES SMTP, see docs/deployment/aws.md) ─────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_ses_smtp_username
MAIL_PASSWORD=CHANGE_ME_ses_smtp_password
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
